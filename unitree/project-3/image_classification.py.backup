import tensorflow as tf
import numpy as np
import json
import video_preprocessing
import os
import cv2

pinyin_to_spot_name = {
    'hangtianguan_0': '航天馆',
    'hangtianguan_1': '航天馆',
    'tushuguan_0': '图书馆',
    'tushuguan_1': '图书馆',
    'tushuguan_2': '图书馆',
    'wozhencangqiong_0': '卧震苍穹',
    'wozhencangqiong_1': '卧震苍穹',
    'xiaobowuguan_0': '小博物馆',
    'xiaobulou_0': '小博物馆',
    'xiaobulou_1': '校部楼',
    'xingzhenglou_0': '行政楼',
    'xingzhenglou_1': '行政楼',
    'xingzhenglou_2': '行政楼',
    'zhulou_0': '主楼',
    'zhulou_1': '主楼',
    'zhulou_2': '主楼',
}

def pinyin_to_name(predicted_pinyin):
    # 使用字典的get方法获取对应的文字名称，如果拼音不在字典中，则返回"未知景点"
    return pinyin_to_spot_name.get(predicted_pinyin, "未知景点")

# 加载类别标签
with open('class_labels.json', 'r') as f:
    class_labels = json.load(f)

# 加载模型
model = tf.keras.models.load_model('./resnet50_model')

def predict_image(img_array):
    predictions = model.predict(img_array)
    predicted_class_index = np.argmax(predictions, axis=1)[0]
    predicted_class_label = class_labels[predicted_class_index]
    predicted_confidence = np.max(predictions, axis=1)[0]
    return predicted_class_label, predicted_confidence

def classify_images(image_folder):
    """
    使用自定义 ResNet50 模型对文件夹中的所有图像进行分类
    返回分类结果和置信度
    """
    class_names = []
    class_confidences = []

    for img_name in os.listdir(image_folder):
        img_path = os.path.join(image_folder, img_name)
        img = cv2.imread(img_path)

        # 预处理图像
        preprocessed_img = video_preprocessing.preprocess_image(img)
        # preprocessed_img = np.expand_dims(preprocessed_img, axis=0)

        predicted_class, confidence = predict_image(preprocessed_img)

        class_name=pinyin_to_name(predicted_class)

        class_names.append(class_name)
        class_confidences.append(confidence)

    return class_names, class_confidences